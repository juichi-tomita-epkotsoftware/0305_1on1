# Docker環境ファイル
# プロジェクト名
COMPOSE_PROJECT_NAME=php8-2

# 各名称(prefix)
NAME_PREFIX=php8-2

# IP情報
## IPは 127.0.0.1～127.255.255.254 の範囲で指定してください（127.0.0.1以外を使う場合、MacOSでは設定が必要です）。
##不明点/上記の注意書きがよくわかっていない
IP=127.0.0.1
PORT_WEB=80
PORT_DB=3307
#PORT_DB：MySQLに接続するためのポート番号
# 02/24修正：PID23468のプロセスが3306を使用中のため3307へ変更
PORT_PHPMYADMIN=8081
#恐らくphpMyAdminに接続するためのポート番号
# 02/24修正：PID23468のプロセスが8080を使用中のため8081へ変更
# DB情報
DB_HOST_NAME=php8-2-db-host
DB_ROOT_PASSWORD=root
